  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main action for the current listening task.",
      "html": "<button class=\"ds-primary\">Find my music</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:9px 15px;border:1px solid var(--line-strong,#829384);border-radius:8px;background:transparent;color:var(--ink,#202e27);font:500 .875rem/1.3 var(--font-text,\"DM Sans\",\"Helvetica Neue\",sans-serif);text-align:center;cursor:pointer;transition:background-color 160ms var(--ease,cubic-bezier(.16,1,.3,1)),border-color 160ms var(--ease,cubic-bezier(.16,1,.3,1));background:var(--button,var(--accent,#315d48));color:var(--button-ink,#fffefa);border-color:transparent;font-weight:600;padding:11px 20px}.ds-primary:hover{background:var(--accent-hover,#244735)}.ds-primary:focus-visible{outline:3px solid var(--focus,#487958);outline-offset:4px;border-radius:4px}.ds-primary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
