      "css": ".ds-pick-chip{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:9px 15px;border:1px solid var(--line-strong,#829384);border-radius:8px;background:transparent;color:var(--ink,#202e27);font:500 .875rem/1.3 var(--font-text,\"DM Sans\",\"Helvetica Neue\",sans-serif);text-align:center;cursor:pointer;transition:background-color 160ms var(--ease,cubic-bezier(.16,1,.3,1)),border-color 160ms var(--ease,cubic-bezier(.16,1,.3,1));border-radius:999px;padding:8px 12px;min-height:36px;font-size:.8125rem;background:var(--paper-raised,#fffefa)}.ds-pick-chip:hover{background:var(--paper-sunk,#edf0e8);border-color:var(--ink-2,#46584d)}.ds-pick-chip:focus-visible{outline:3px solid var(--focus,#487958);outline-offset:4px;border-radius:4px}.ds-pick-chip:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-pick-chip{transition:none}}.ds-pick-chip span{margin-left:5px}@media(max-width:650px){.ds-pick-chip{min-height:44px}}"
