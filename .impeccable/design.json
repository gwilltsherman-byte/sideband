  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main action for the current listening task.",
      "html": "<button class=\"ds-primary\">Find my music</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:9px 15px;border:1px solid var(--line-strong,#928087);border-radius:8px;background:transparent;color:var(--ink,#30252a);font:500 .875rem/1.3 var(--font-text,\"DM Sans\",\"Helvetica Neue\",sans-serif);text-align:center;cursor:pointer;transition:background-color 160ms var(--ease,cubic-bezier(.16,1,.3,1)),border-color 160ms var(--ease,cubic-bezier(.16,1,.3,1));background:var(--button,var(--accent,#7a304b));color:var(--button-ink,#fffdf7);border-color:transparent;font-weight:600;padding:11px 20px}.ds-primary:hover{background:var(--accent-hover,#5e2039)}.ds-primary:focus-visible{outline:3px solid var(--focus,#a64b69);outline-offset:4px;border-radius:4px}.ds-primary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A supporting action with a clear outline.",
      "html": "<button class=\"ds-secondary\">Show more artists</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:9px 15px;border:1px solid var(--line-strong,#928087);border-radius:8px;background:transparent;color:var(--ink,#30252a);font:500 .875rem/1.3 var(--font-text,\"DM Sans\",\"Helvetica Neue\",sans-serif);text-align:center;cursor:pointer;transition:background-color 160ms var(--ease,cubic-bezier(.16,1,.3,1)),border-color 160ms var(--ease,cubic-bezier(.16,1,.3,1));}.ds-secondary:hover{background:var(--paper-sunk,#f0e9de);border-color:var(--ink-2,#57494e)}.ds-secondary:focus-visible{outline:3px solid var(--focus,#a64b69);outline-offset:4px;border-radius:4px}.ds-secondary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Quiet action",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Low-emphasis actions such as Undo and Already know.",
      "html": "<button class=\"ds-quiet\">Undo</button>",
      "css": ".ds-quiet{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:9px 15px;border:1px solid var(--line-strong,#928087);border-radius:8px;background:transparent;color:var(--ink,#30252a);font:500 .875rem/1.3 var(--font-text,\"DM Sans\",\"Helvetica Neue\",sans-serif);text-align:center;cursor:pointer;transition:background-color 160ms var(--ease,cubic-bezier(.16,1,.3,1)),border-color 160ms var(--ease,cubic-bezier(.16,1,.3,1));border-color:transparent;color:var(--muted,#6d6065)}.ds-quiet:hover{background:var(--paper-sunk,#f0e9de);border-color:var(--ink-2,#57494e)}.ds-quiet:focus-visible{outline:3px solid var(--focus,#a64b69);outline-offset:4px;border-radius:4px}.ds-quiet:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-quiet{transition:none}}"
    },
    {
      "name": "Artist search",
      "kind": "input",
      "refersTo": "input-search",
      "description": "A labeled native search field using the raised work surface.",
      "html": "<label class=\"ds-search-label\" for=\"ds-search\">Search artists</label><input class=\"ds-search\" id=\"ds-search\" type=\"search\" placeholder=\"Search any artist…\">",
      "css": ".ds-search-label{display:block;font:500 .875rem/1.55 var(--font-text,\"DM Sans\",\"Helvetica Neue\",sans-serif);color:var(--ink,#30252a);margin-bottom:8px}.ds-search{width:100%;min-height:50px;padding:10px 14px;border:1px solid var(--line-strong,#928087);border-radius:8px;background:var(--paper-raised,#fffdf7);color:var(--ink,#30252a);font:400 1rem/1.55 var(--font-text,\"DM Sans\",\"Helvetica Neue\",sans-serif);caret-color:var(--accent,#7a304b)}.ds-search::placeholder{color:var(--muted,#6d6065);opacity:1}.ds-search:focus-visible{outline:3px solid var(--focus,#a64b69);outline-offset:4px;border-radius:4px}"
    },
    {
      "name": "Aubergine navigation",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "The aubergine rail’s labeled links, amber current destination, wine hover, and keyboard focus.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Sections\"><a href=\"#for-you\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg><span>For you</span></a><a href=\"#songs\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 18V5l11-2v13M9 8l11-2\"/><ellipse cx=\"6\" cy=\"18\" rx=\"3\" ry=\"2\"/><ellipse cx=\"17\" cy=\"16\" rx=\"3\" ry=\"2\"/></svg><span>Songs</span></a><a href=\"#explore\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"m16 8-3 5-5 3 3-5Z\"/></svg><span>Explore</span></a><a href=\"#taste\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 5c-3-3-7-1-8 1-1-2-5-4-8-1-4 4 2 10 8 15 6-5 12-11 8-15Z\"/></svg><span>Your taste</span></a><a href=\"#accuracy\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 20V10m8 10V4m8 16v-7\"/></svg><span>Accuracy</span></a><a href=\"#setup\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 7h16M4 17h16\"/><circle cx=\"9\" cy=\"7\" r=\"3\"/><circle cx=\"15\" cy=\"17\" r=\"3\"/></svg><span>Setup</span></a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:5px;width:176px;padding:18px;background:var(--rail,#331c2a)}.ds-nav a{display:flex;align-items:center;gap:13px;min-height:46px;padding:10px 16px;color:var(--rail-muted,#d9bfcc);font:400 .9375rem/1.55 var(--font-text,\"DM Sans\",\"Helvetica Neue\",sans-serif);text-decoration:none;border-radius:8px}.ds-nav a:nth-child(4){margin-top:28px}.ds-nav a:hover{background:var(--rail-active,#593247);color:var(--rail-ink,#fff3dc)}.ds-nav a[aria-current=page]{background:var(--rail-current,#eec36d);color:var(--rail-current-ink,#392332);font-weight:600}.ds-nav a:focus-visible{outline:3px solid var(--rail-ink,#fff3dc);outline-offset:4px}.ds-nav svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:none}"
    },
    {
      "name": "Picked artist chip",
      "kind": "chip",
      "refersTo": "pick-chip",
      "description": "A removable saved favorite, with a readable removal label.",
      "html": "<button class=\"ds-pick-chip\" aria-label=\"Remove Radiohead from my picks\">Radiohead <span aria-hidden=\"true\">×</span></button>",
      "css": ".ds-pick-chip{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:9px 15px;border:1px solid var(--line-strong,#928087);border-radius:8px;background:transparent;color:var(--ink,#30252a);font:500 .875rem/1.3 var(--font-text,\"DM Sans\",\"Helvetica Neue\",sans-serif);text-align:center;cursor:pointer;transition:background-color 160ms var(--ease,cubic-bezier(.16,1,.3,1)),border-color 160ms var(--ease,cubic-bezier(.16,1,.3,1));border-radius:999px;padding:8px 12px;min-height:36px;font-size:.8125rem;background:var(--paper-raised,#fffdf7)}.ds-pick-chip:hover{background:var(--paper-sunk,#f0e9de);border-color:var(--ink-2,#57494e)}.ds-pick-chip:focus-visible{outline:3px solid var(--focus,#a64b69);outline-offset:4px;border-radius:4px}.ds-pick-chip:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-pick-chip{transition:none}}.ds-pick-chip span{margin-left:5px}@media(max-width:650px){.ds-pick-chip{min-height:44px}}"
    },
    {
      "name": "Starting-point area",
      "kind": "card",
      "refersTo": "starting-point",
      "description": "A recessed summary of the listener’s picks, without a card shadow.",
      "html": "<aside class=\"ds-starting\" aria-labelledby=\"ds-starting-heading\"><h2 id=\"ds-starting-heading\">Your starting point</h2><p>A little of what you love. A way into something new.</p><p class=\"ds-starting-count\">3 favourites picked</p></aside>",
      "css": ".ds-starting{background:var(--paper-sunk,#f0e9de);color:var(--ink,#30252a);border-radius:var(--radius,12px);padding:26px 24px;font:400 .875rem/1.55 var(--font-text,\"DM Sans\",\"Helvetica Neue\",sans-serif)}.ds-starting h2{font:500 1.5rem/1.2 var(--font-display,Fraunces,Georgia,serif);margin:0 0 10px}.ds-starting p{margin:0;color:var(--muted,#6d6065)}.ds-starting .ds-starting-count{font-size:.8125rem;font-weight:600;margin:25px 0 12px;padding-bottom:12px;border-bottom:1px solid var(--line-strong,#928087);color:var(--ink,#30252a)}"
    },
    {
      "name": "Artist choice",
      "kind": "button",
      "refersTo": "artist-choice",
      "description": "A flat artist selector with a rose selection wash, wine text, and Pick/Picked marker.",
      "html": "<button class=\"ds-artist-choice\" aria-pressed=\"true\"><span class=\"ds-artist-name\">Nina Simone</span><span class=\"ds-artist-mark\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m5 12 4 4L19 6\"/></svg>Picked</span></button>",
      "css": ".ds-artist-choice{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:9px 15px;border:1px solid var(--line-strong,#928087);border-radius:8px;background:transparent;color:var(--ink,#30252a);font:500 .875rem/1.3 var(--font-text,\"DM Sans\",\"Helvetica Neue\",sans-serif);text-align:center;cursor:pointer;transition:background-color 160ms var(--ease,cubic-bezier(.16,1,.3,1)),border-color 160ms var(--ease,cubic-bezier(.16,1,.3,1));display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:7px;min-height:93px;padding:14px 4px;border-width:0 0 1px;border-color:var(--line,#ded3cf);border-radius:0;text-align:left}.ds-artist-choice:hover{background:var(--paper-sunk,#f0e9de);border-color:var(--ink-2,#57494e)}.ds-artist-choice:focus-visible{outline:3px solid var(--focus,#a64b69);outline-offset:4px;border-radius:4px}.ds-artist-choice:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-artist-choice{transition:none}}.ds-artist-choice[aria-pressed=true]{color:var(--accent,#7a304b);background:var(--selection,#f3e4ea);border-color:var(--line,#ded3cf)}.ds-artist-name{font-size:.9375rem;font-weight:600;line-height:1.3}.ds-artist-mark{display:inline-flex;align-items:center;gap:5px;font-size:.75rem;font-weight:400}.ds-artist-mark svg{width:13px;height:13px;stroke:currentColor;stroke-width:1.7;fill:none;stroke-linecap:round;stroke-linejoin:round}@media(max-width:650px){.ds-artist-choice{min-height:86px}}"
    },
    {
      "name": "Discovery row",
      "kind": "custom",
      "refersTo": "recommendation-row",
      "description": "A music-first row with familiar connections and an amber candidate-percentile label. Illustrative preview content only.",
      "html": "<article class=\"ds-rec\"><div class=\"ds-rec-rank\">01</div><div><h3 class=\"ds-rec-name\">Example artist</h3><p class=\"ds-rec-tags\">Illustrative component preview</p><p class=\"ds-rec-why\">Because of <b>your picked artists</b> in your taste.</p></div><div class=\"ds-percentile\"><b>84</b><span>percentile</span></div></article>",
      "css": ".ds-rec{display:grid;grid-template-columns:32px minmax(0,1fr) 80px;gap:16px;padding:26px 0;border-bottom:1px solid var(--line,#ded3cf);color:var(--ink,#30252a);font:400 1rem/1.55 var(--font-text,\"DM Sans\",\"Helvetica Neue\",sans-serif)}.ds-rec-rank{padding-top:7px;font-size:.8125rem;color:var(--muted,#6d6065);font-variant-numeric:tabular-nums}.ds-rec-name{font:500 1.875rem/1.15 var(--font-display,Fraunces,Georgia,serif);letter-spacing:-.025em;margin:0;overflow-wrap:anywhere}.ds-rec-tags{font-size:.75rem;color:var(--muted,#6d6065);margin:7px 0 12px}.ds-rec-why{font-size:.875rem;color:var(--ink-2,#57494e);margin:0 0 8px}.ds-rec-why b{font-weight:600;color:var(--ink,#30252a)}.ds-percentile{align-self:start;color:var(--sticker-ink,#634514);background:var(--sticker,#f4dfa5);border-radius:8px;padding:10px 12px;text-align:center}.ds-percentile b{font:500 1.4rem/1.1 var(--font-text,\"DM Sans\",\"Helvetica Neue\",sans-serif);font-variant-numeric:tabular-nums;display:block}.ds-percentile span{font-size:.625rem}@media(max-width:650px){.ds-rec{grid-template-columns:minmax(0,1fr) 66px;gap:10px;padding:24px 0}.ds-rec-rank{display:none}.ds-rec-name{font-size:1.625rem}.ds-percentile{padding:9px 6px}.ds-percentile span{font-size:.6875rem}}"
    },
    {
      "name": "Evidence disclosure",
      "kind": "custom",
      "refersTo": "evidence-details",
      "description": "Native disclosure for detailed evidence; the table carries signed effects in text. Illustrative values only.",
      "html": "<details class=\"ds-why\"><summary>Why this match <span>2 supporting signals</span></summary><div class=\"ds-evidence\"><p>Illustrative component preview</p><svg class=\"ds-meter\" width=\"240\" height=\"18\" viewBox=\"0 0 240 18\" role=\"img\" aria-label=\"Illustrative evidence: 2 signals for, 0 against, net 0.80\"><rect class=\"ds-track\" x=\"0\" y=\"3\" width=\"240\" height=\"12\" rx=\"4\"/><path class=\"ds-pos\" d=\"M121 3h58v12h-58Z\"/><path class=\"ds-pos\" d=\"M181 3h14q4 0 4 4v4q0 4-4 4h-14Z\"/><line class=\"ds-axis\" x1=\"120\" x2=\"120\" y1=\"0\" y2=\"18\"/><line class=\"ds-net\" x1=\"200\" x2=\"200\" y1=\"0\" y2=\"18\"/></svg><table><thead><tr><th>Signal (standardised)</th><th>Effect</th></tr></thead><tbody><tr><td>Similar artists</td><td>+0.60</td></tr><tr><td>Shared taste</td><td>+0.20</td></tr><tr><td>Net score</td><td>+0.80</td></tr></tbody></table></div></details>",
      "css": ".ds-why{font:400 .75rem/1.55 var(--font-text,\"DM Sans\",\"Helvetica Neue\",sans-serif);color:var(--ink-2,#57494e);margin-top:6px}.ds-why summary{min-height:32px;padding:4px 0;cursor:pointer}.ds-why summary:focus-visible{outline:3px solid var(--focus,#a64b69);outline-offset:4px;border-radius:4px}.ds-why summary span{margin-left:10px;color:var(--muted,#6d6065)}.ds-why[open]>summary{margin-bottom:8px}.ds-evidence{max-width:600px;overflow:auto;margin:12px 0 18px}.ds-evidence table{width:100%;min-width:260px;border-collapse:collapse;font-size:.8125rem}.ds-evidence th,.ds-evidence td{padding:12px 14px 12px 0;border-bottom:1px solid var(--line,#ded3cf);text-align:left}.ds-evidence th{font-weight:500;color:var(--muted,#6d6065)}.ds-evidence td:last-child,.ds-evidence th:last-child{text-align:right}.ds-evidence td:last-child{font:.75rem/1.55 var(--font-mono,ui-monospace,\"SFMono-Regular\",Menlo,monospace);font-variant-numeric:tabular-nums}@media(max-width:650px){.ds-why summary{min-height:44px}.ds-why summary span{display:none}}.ds-meter{display:block;max-width:100%;height:auto;margin:12px 0 18px}.ds-track{fill:var(--paper-sunk,#f0e9de)}.ds-pos{fill:var(--pos,#27715e)}.ds-axis{stroke:var(--line-strong,#928087);stroke-width:1}.ds-net{stroke:var(--ink,#30252a);stroke-width:2}"
    }
  ],
  "narrative": {
    "northStar": "The independent listening journal",
    "overview": "Sideband takes its colors from record sleeves and independent music publishing: an ivory work surface, a deep aubergine navigation rail, wine-colored actions, and amber labels. Fraunces gives music names and page titles an editorial voice; DM Sans keeps controls, explanations, and dense data direct. Dark mode uses aubergine surfaces and pale rose accents while retaining the amber wayfinding.\n\nMusic names, familiar connections, and listening actions establish the identity. Thin dividers and tonal areas organize the workspace; photographic artist results appear only when provided by the lookup service. The interface does not invent album artwork. Native controls and compact disclosures keep the product approachable without hiding its evidence.",
    "keyCharacteristics": [
      "An aubergine rail with amber current-state labels, retaining all six destinations on mobile.",
      "Editorial music typography paired with plain, compact controls.",
      "Record-sleeve ivory surfaces, wine ink, thin dividers, and restrained floating shadows.",
      "Readable light and dark themes with visible keyboard focus.",
      "Supporting evidence revealed through native disclosures."
    ],
    "rules": [
      {
        "name": "The Signal Color Rule",
        "body": "Reserve green for positive evidence and liked feedback. Use wine and rose for selections, actions, and taste data; use amber for current navigation, the record mark, and percentile labels.",
        "section": "colors"
      },
      {
        "name": "The Music Voice Rule",
        "body": "Use Fraunces for page titles, discovery artist names, territory headings, and key editorial summaries. Keep form controls and song rows in DM Sans.",
        "section": "typography"
      },
      {
        "name": "The Floating Surface Rule",
        "body": "Keep ordinary sections and recommendation rows flat. Use the shared shadow for content that floats above the workspace: tooltips, toasts, and the mobile discovery action.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the existing semantic CSS variables so theme changes apply to every component.",
      "Do keep green limited to positive evidence and liked feedback; use the wine accent for taste bars and the rose wash for selections.",
      "Do keep artist names and familiar connections prominent, with supporting model detail in disclosures.",
      "Do retain visible focus, native controls, textual state labels, and reduced-motion behavior.",
      "Do keep feedback in its existing row with a saved message and Undo until the listener refreshes.",
      "Do preserve all six navigation destinations and the fixed discovery action on small Setup screens.",
      "Do label candidate percentile, provisional estimates, and synthetic demo evidence distinctly."
    ],
    "donts": [
      "Don't substitute a generic green brand palette for Sideband's record-sleeve ivory, wine, aubergine, and amber identity.",
      "Don't add fabricated artwork, testimonials, listening counts, or accuracy claims.",
      "Don't turn ordinary recommendation rows into stacked raised cards.",
      "Don't use color alone to communicate selected artists, ratings, errors, or signal direction.",
      "Don't replace native selects, ranges, radio buttons, or disclosure semantics with decorative imitations.",
      "Don't introduce external font requests; use the local font files and retain their licenses.",
      "Don't change a candidate percentile into a like probability or present unavailable previews as playable."
    ]
  }
}
