    {
      "name": "Artist search",
      "kind": "input",
      "refersTo": "input-search",
      "description": "A labeled native search field using the raised work surface.",
      "html": "<label class=\"ds-search-label\" for=\"ds-search\">Search artists</label><input class=\"ds-search\" id=\"ds-search\" type=\"search\" placeholder=\"Search any artist…\">",
      "css": ".ds-search-label{display:block;font:500 .875rem/1.55 var(--font-text,\"DM Sans\",\"Helvetica Neue\",sans-serif);color:var(--ink,#202e27);margin-bottom:8px}.ds-search{width:100%;min-height:50px;padding:10px 14px;border:1px solid var(--line-strong,#829384);border-radius:8px;background:var(--paper-raised,#fffefa);color:var(--ink,#202e27);font:400 1rem/1.55 var(--font-text,\"DM Sans\",\"Helvetica Neue\",sans-serif);caret-color:var(--accent,#315d48)}.ds-search::placeholder{color:var(--muted,#637067);opacity:1}.ds-search:focus-visible{outline:3px solid var(--focus,#487958);outline-offset:4px;border-radius:4px}"
